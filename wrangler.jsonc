{
  "name": "aot",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    { "pattern": "aotwears.store", "custom_domain": true },
    { "pattern": "www.aotwears.store", "custom_domain": true }
  ],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "GITHUB_REPO": "Ayindecodes/aot",
    "GITHUB_AUTHOR_NAME": "Ayinde",
    "GITHUB_AUTHOR_EMAIL": "ayindegraphicscreation@gmail.com",
    "ORDER_FROM_EMAIL": "AOT.ng Orders <orders@aotwears.store>"
  }
}
